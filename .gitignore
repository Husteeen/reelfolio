# Environment files (NEVER commit these — they contain secrets!)
.env
.env.local
.env.*.local
# NOTE: .env.production is intentionally NOT ignored — it only contains public API URL

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
server/dist/

# Prisma generated client (regenerated on deploy)
server/node_modules/.prisma/

# SQLite dev database (if used locally)
*.db
*.db-journal

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Vite cache
client/.vite/
