generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  VIMEO
}

enum VideoStatus {
  DRAFT
  PUBLISHED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  REMOVED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        Profile?
  videos         Video[]
  reportsSubmitted ContentReport[] @relation("Reporter")
  reportsReceived  ContentReport[] @relation("ReportedUser")

  @@index([email])
}

model Profile {
  id          String     @id @default(cuid())
  userId      String     @unique
  username    String     @unique
  displayName String
  bio         String?
  avatarUrl   String?
  socialLinks Json?      // { twitter, linkedin, instagram, website }
  skills      String[]   @default([])
  visibility  Visibility @default(PUBLIC)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  videos Video[]
}

model Video {
  id           String      @id @default(cuid())
  userId       String
  categoryId   String?
  title        String
  description  String?
  sourceType   VideoSource
  sourceUrl    String?     // YouTube / Vimeo URL
  storageKey   String?     // S3 object key (Phase 5)
  thumbnailUrl String?
  status       VideoStatus @default(DRAFT)
  isFeatured   Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reports  ContentReport[]

  @@index([userId])
  @@index([status])
}

model ContentReport {
  id             String       @id @default(cuid())
  reporterUserId String?
  reportedUserId String?
  videoId        String?
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter   User?  @relation("Reporter",     fields: [reporterUserId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  video      Video? @relation(fields: [videoId],        references: [id], onDelete: SetNull)
}
